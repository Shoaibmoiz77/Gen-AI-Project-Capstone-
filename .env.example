# Set ONE of these. The provider is picked from whichever key is present.
ANTHROPIC_API_KEY=
# GROQ_API_KEY=          # free tier: https://console.groq.com
# GEMINI_API_KEY=        # free tier: https://aistudio.google.com

# Optional overrides
# GROUNDWORK_MODEL=               # empty = provider default
# GROUNDWORK_JUDGE_MODEL=
# GROUNDWORK_BASE_URL=            # any OpenAI-compatible server
# GROUNDWORK_EMBEDDER=hashing        # hashing | voyage | fastembed
# GROUNDWORK_RETRIEVAL=hybrid        # bm25 | dense | hybrid
# GROUNDWORK_TOP_K=6
# VOYAGE_API_KEY=                    # needed when GROUNDWORK_EMBEDDER=voyage
